{
  "$id": "heniek://contract/NativeStageQuestionResult/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "accepted"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "accepted": {
      "type": "boolean"
    },
    "rejectionCode": {
      "anyOf": [
        {
          "const": "session_not_attached",
          "type": "string"
        },
        {
          "const": "session_expired",
          "type": "string"
        },
        {
          "const": "stale_session_revision",
          "type": "string"
        },
        {
          "const": "unknown_dispatch",
          "type": "string"
        },
        {
          "const": "stale_dispatch_revision",
          "type": "string"
        },
        {
          "const": "dispatch_revoked",
          "type": "string"
        },
        {
          "const": "dispatch_already_settled",
          "type": "string"
        },
        {
          "const": "idempotency_key_reuse",
          "type": "string"
        },
        {
          "const": "run_terminal",
          "type": "string"
        },
        {
          "const": "artifact_missing",
          "type": "string"
        },
        {
          "const": "result_contract_violation",
          "type": "string"
        },
        {
          "const": "workspace_mutated",
          "type": "string"
        }
      ]
    },
    "interactionId": {
      "minLength": 1,
      "description": "Opaque InteractionId.",
      "type": "string"
    },
    "interactionRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "dispatchRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    }
  }
}
