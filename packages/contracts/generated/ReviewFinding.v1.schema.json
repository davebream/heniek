{
  "$id": "heniek://contract/ReviewFinding/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "findingId",
    "severity",
    "title",
    "detail",
    "evidence",
    "disposition",
    "claimVerification"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "findingId": {
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_-]*$",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "const": "critical",
          "type": "string"
        },
        {
          "const": "major",
          "type": "string"
        },
        {
          "const": "minor",
          "type": "string"
        }
      ]
    },
    "title": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "detail": {
      "minLength": 1,
      "maxLength": 16384,
      "type": "string"
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "path",
              "startLine"
            ],
            "properties": {
              "kind": {
                "const": "source",
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$",
                "type": "string"
              },
              "startLine": {
                "minimum": 1,
                "type": "integer"
              },
              "endLine": {
                "minimum": 1,
                "type": "integer"
              },
              "contentHash": {
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "checkId",
              "exitCode"
            ],
            "properties": {
              "kind": {
                "const": "command",
                "type": "string"
              },
              "checkId": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "exitCode": {
                "minimum": 0,
                "maximum": 255,
                "type": "integer"
              },
              "artifactId": {
                "minLength": 1,
                "description": "Opaque ArtifactId.",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "artifactId",
              "contentHash"
            ],
            "properties": {
              "kind": {
                "const": "artifact",
                "type": "string"
              },
              "artifactId": {
                "minLength": 1,
                "description": "Opaque ArtifactId.",
                "type": "string"
              },
              "contentHash": {
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "disposition": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "accepted",
              "type": "string"
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "rejected",
              "type": "string"
            },
            "reason": {
              "minLength": 1,
              "maxLength": 16384,
              "type": "string"
            }
          }
        }
      ]
    },
    "claimVerification": {
      "anyOf": [
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "state",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "verified",
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "path",
                      "startLine"
                    ],
                    "properties": {
                      "kind": {
                        "const": "source",
                        "type": "string"
                      },
                      "path": {
                        "minLength": 1,
                        "maxLength": 1024,
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$",
                        "type": "string"
                      },
                      "startLine": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "endLine": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "contentHash": {
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "checkId",
                      "exitCode"
                    ],
                    "properties": {
                      "kind": {
                        "const": "command",
                        "type": "string"
                      },
                      "checkId": {
                        "minLength": 1,
                        "maxLength": 128,
                        "type": "string"
                      },
                      "exitCode": {
                        "minimum": 0,
                        "maximum": 255,
                        "type": "integer"
                      },
                      "artifactId": {
                        "minLength": 1,
                        "description": "Opaque ArtifactId.",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "artifactId",
                      "contentHash"
                    ],
                    "properties": {
                      "kind": {
                        "const": "artifact",
                        "type": "string"
                      },
                      "artifactId": {
                        "minLength": 1,
                        "description": "Opaque ArtifactId.",
                        "type": "string"
                      },
                      "contentHash": {
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "additionalProperties": false,
          "type": "object",
          "required": [
            "state",
            "evidence"
          ],
          "properties": {
            "state": {
              "const": "retracted",
              "type": "string"
            },
            "evidence": {
              "minItems": 1,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "path",
                      "startLine"
                    ],
                    "properties": {
                      "kind": {
                        "const": "source",
                        "type": "string"
                      },
                      "path": {
                        "minLength": 1,
                        "maxLength": 1024,
                        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$",
                        "type": "string"
                      },
                      "startLine": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "endLine": {
                        "minimum": 1,
                        "type": "integer"
                      },
                      "contentHash": {
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "checkId",
                      "exitCode"
                    ],
                    "properties": {
                      "kind": {
                        "const": "command",
                        "type": "string"
                      },
                      "checkId": {
                        "minLength": 1,
                        "maxLength": 128,
                        "type": "string"
                      },
                      "exitCode": {
                        "minimum": 0,
                        "maximum": 255,
                        "type": "integer"
                      },
                      "artifactId": {
                        "minLength": 1,
                        "description": "Opaque ArtifactId.",
                        "type": "string"
                      }
                    }
                  },
                  {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "kind",
                      "artifactId",
                      "contentHash"
                    ],
                    "properties": {
                      "kind": {
                        "const": "artifact",
                        "type": "string"
                      },
                      "artifactId": {
                        "minLength": 1,
                        "description": "Opaque ArtifactId.",
                        "type": "string"
                      },
                      "contentHash": {
                        "minLength": 64,
                        "maxLength": 64,
                        "pattern": "^[0-9a-f]{64}$",
                        "type": "string"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      ]
    }
  }
}
