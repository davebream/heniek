{
  "$id": "heniek://contract/PipelineRunResult/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "accepted",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "accepted": {
      "type": "boolean"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "pipelineId": {
      "minLength": 1,
      "description": "Opaque PipelineId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "scheduleRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "snapshot": {
      "$ref": "heniek://contract/PipelineRunSnapshot/v1"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "const": "error",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              },
              {
                "const": "info",
                "type": "string"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "pointer": {
            "type": "string"
          },
          "suggestion": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  }
}
