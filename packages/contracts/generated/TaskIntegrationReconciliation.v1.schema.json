{
  "$id": "heniek://contract/TaskIntegrationReconciliation/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "reconciliationId",
    "integrationId",
    "runId",
    "taskId",
    "trigger",
    "lifecycle",
    "resolution",
    "blocker",
    "pass",
    "repositories",
    "verificationReportId",
    "revision",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "reconciliationId": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "integrationId": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "description": "Opaque ExecutionTaskId.",
      "type": "string"
    },
    "trigger": {
      "anyOf": [
        {
          "const": "interrupted_prepare",
          "type": "string"
        },
        {
          "const": "interrupted_verify",
          "type": "string"
        },
        {
          "const": "interrupted_publish",
          "type": "string"
        },
        {
          "const": "partial_publish",
          "type": "string"
        },
        {
          "const": "branch_drift",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        }
      ]
    },
    "lifecycle": {
      "anyOf": [
        {
          "const": "observing",
          "type": "string"
        },
        {
          "const": "forwarding",
          "type": "string"
        },
        {
          "const": "integrated",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        }
      ]
    },
    "resolution": {
      "anyOf": [
        {
          "const": "forward_published",
          "type": "string"
        },
        {
          "const": "adopted_published",
          "type": "string"
        },
        {
          "const": "mixed_forward_and_adopt",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocker": {
      "anyOf": [
        {
          "const": "external_mutation",
          "type": "string"
        },
        {
          "const": "missing_evidence",
          "type": "string"
        },
        {
          "const": "observation_failed",
          "type": "string"
        },
        {
          "const": "identity_mismatch",
          "type": "string"
        },
        {
          "const": "ambiguous_state",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "pass": {
      "minimum": 0,
      "type": "integer"
    },
    "repositories": {
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repositoryId",
          "expectedSha",
          "candidateSha",
          "observedSha",
          "classification",
          "action",
          "detail"
        ],
        "properties": {
          "repositoryId": {
            "minLength": 1,
            "description": "Opaque RepositoryId.",
            "type": "string"
          },
          "expectedSha": {
            "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
            "type": "string"
          },
          "candidateSha": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedSha": {
            "anyOf": [
              {
                "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "classification": {
            "anyOf": [
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "applied",
                "type": "string"
              },
              {
                "const": "missing_candidate",
                "type": "string"
              },
              {
                "const": "missing_ref",
                "type": "string"
              },
              {
                "const": "observation_failed",
                "type": "string"
              },
              {
                "const": "external_mutation",
                "type": "string"
              },
              {
                "const": "identity_mismatch",
                "type": "string"
              }
            ]
          },
          "action": {
            "anyOf": [
              {
                "const": "publish",
                "type": "string"
              },
              {
                "const": "adopt",
                "type": "string"
              },
              {
                "const": "none",
                "type": "string"
              },
              {
                "const": "block",
                "type": "string"
              }
            ]
          },
          "detail": {
            "anyOf": [
              {
                "minLength": 1,
                "maxLength": 1024,
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "verificationReportId": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
