{
  "$id": "heniek://contract/TaskGraphRevisionDecision/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "decisionId",
    "runId",
    "graphId",
    "proposal",
    "proposalSha256",
    "expectedGraphRevision",
    "outcome",
    "proposedRevisionSha256",
    "diagnostics",
    "beforeWaves",
    "afterWaves",
    "affectedTaskIds",
    "affectedWaveOrdinals",
    "taskStates",
    "maxGraphRevisions",
    "decidedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "decisionId": {
      "minLength": 1,
      "description": "Opaque TaskGraphRevisionDecisionId.",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "graphId": {
      "minLength": 1,
      "description": "Opaque TaskGraphId.",
      "type": "string"
    },
    "proposal": {
      "$ref": "heniek://contract/TaskGraphRevisionProposal/v1"
    },
    "proposalSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "expectedGraphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "outcome": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "rejected",
          "type": "string"
        }
      ]
    },
    "proposedRevisionSha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "diagnostics": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message",
          "taskIds"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          },
          "message": {
            "minLength": 1,
            "maxLength": 8192,
            "type": "string"
          },
          "taskIds": {
            "maxItems": 4096,
            "type": "array",
            "items": {
              "minLength": 1,
              "description": "Opaque ExecutionTaskId.",
              "type": "string"
            }
          }
        }
      }
    },
    "beforeWaves": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ordinal",
          "taskIds"
        ],
        "properties": {
          "ordinal": {
            "minimum": 1,
            "type": "integer"
          },
          "taskIds": {
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 4096,
            "type": "array",
            "items": {
              "minLength": 1,
              "description": "Opaque ExecutionTaskId.",
              "type": "string"
            }
          }
        }
      }
    },
    "afterWaves": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ordinal",
          "taskIds"
        ],
        "properties": {
          "ordinal": {
            "minimum": 1,
            "type": "integer"
          },
          "taskIds": {
            "minItems": 1,
            "uniqueItems": true,
            "maxItems": 4096,
            "type": "array",
            "items": {
              "minLength": 1,
              "description": "Opaque ExecutionTaskId.",
              "type": "string"
            }
          }
        }
      }
    },
    "affectedTaskIds": {
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque ExecutionTaskId.",
        "type": "string"
      }
    },
    "affectedWaveOrdinals": {
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "taskStates": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taskId",
          "outcome",
          "completionContract",
          "integration",
          "combinedVerification"
        ],
        "properties": {
          "taskId": {
            "minLength": 1,
            "description": "Opaque ExecutionTaskId.",
            "type": "string"
          },
          "outcome": {
            "anyOf": [
              {
                "const": "not_started",
                "type": "string"
              },
              {
                "const": "active",
                "type": "string"
              },
              {
                "const": "succeeded",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              },
              {
                "const": "cancelled",
                "type": "string"
              },
              {
                "const": "blocked",
                "type": "string"
              }
            ]
          },
          "completionContract": {
            "anyOf": [
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              }
            ]
          },
          "integration": {
            "anyOf": [
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "reconciliation_required",
                "type": "string"
              }
            ]
          },
          "combinedVerification": {
            "anyOf": [
              {
                "const": "pending",
                "type": "string"
              },
              {
                "const": "passed",
                "type": "string"
              },
              {
                "const": "failed",
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "maxGraphRevisions": {
      "minimum": 1,
      "type": "integer"
    },
    "decidedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
