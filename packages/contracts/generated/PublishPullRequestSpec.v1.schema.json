{
  "$id": "heniek://contract/PublishPullRequestSpec/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "repositoryId",
    "sourceBranch",
    "targetBranch",
    "title",
    "body",
    "expectedHeadSha",
    "draft",
    "markReady",
    "enableAutoMerge"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "repositoryId": {
      "minLength": 1,
      "description": "Opaque RepositoryId.",
      "type": "string"
    },
    "sourceBranch": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "targetBranch": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "body": {
      "maxLength": 65536,
      "type": "string"
    },
    "expectedHeadSha": {
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "draft": {
      "type": "boolean"
    },
    "markReady": {
      "type": "boolean"
    },
    "enableAutoMerge": {
      "type": "boolean"
    }
  }
}
