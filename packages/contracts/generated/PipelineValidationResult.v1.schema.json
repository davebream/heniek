{
  "$id": "heniek://contract/PipelineValidationResult/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "diagnostics"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sourcePath": {
      "minLength": 1,
      "type": "string"
    },
    "graph": {
      "$ref": "heniek://contract/PipelineGraph/v1"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "properties": {
          "code": {
            "minLength": 1,
            "type": "string"
          },
          "severity": {
            "anyOf": [
              {
                "const": "error",
                "type": "string"
              },
              {
                "const": "warning",
                "type": "string"
              },
              {
                "const": "info",
                "type": "string"
              }
            ]
          },
          "message": {
            "type": "string"
          },
          "sourcePath": {
            "type": "string"
          },
          "line": {
            "minimum": 1,
            "type": "integer"
          },
          "column": {
            "minimum": 1,
            "type": "integer"
          },
          "pointer": {
            "type": "string"
          },
          "suggestion": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    }
  }
}
