{
  "$id": "heniek://contract/FindingSnapshot/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "findingId",
    "originReportId",
    "originStageId",
    "severity",
    "disposition",
    "claimVerificationState",
    "repairState",
    "resolutionState",
    "latestReportId",
    "latestReportArtifactId",
    "latestReportContentHash",
    "evidence",
    "revision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "findingId": {
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_-]*$",
      "type": "string"
    },
    "originReportId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "originStageId": {
      "minLength": 1,
      "description": "Opaque PipelineStageId.",
      "type": "string"
    },
    "severity": {
      "anyOf": [
        {
          "const": "critical",
          "type": "string"
        },
        {
          "const": "major",
          "type": "string"
        },
        {
          "const": "minor",
          "type": "string"
        }
      ]
    },
    "disposition": {
      "anyOf": [
        {
          "const": "accepted",
          "type": "string"
        },
        {
          "const": "rejected",
          "type": "string"
        }
      ]
    },
    "claimVerificationState": {
      "anyOf": [
        {
          "const": "verified",
          "type": "string"
        },
        {
          "const": "retracted",
          "type": "string"
        }
      ]
    },
    "repairState": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "applied",
          "type": "string"
        },
        {
          "const": "skipped",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "not_required",
          "type": "string"
        }
      ]
    },
    "resolutionState": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "fixed",
          "type": "string"
        },
        {
          "const": "unresolved",
          "type": "string"
        },
        {
          "const": "not_applicable",
          "type": "string"
        }
      ]
    },
    "latestReportId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "latestReportArtifactId": {
      "minLength": 1,
      "description": "Opaque ArtifactId.",
      "type": "string"
    },
    "latestReportContentHash": {
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "evidence": {
      "minItems": 1,
      "type": "array",
      "items": {
        "anyOf": [
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "path",
              "startLine"
            ],
            "properties": {
              "kind": {
                "const": "source",
                "type": "string"
              },
              "path": {
                "minLength": 1,
                "maxLength": 1024,
                "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$",
                "type": "string"
              },
              "startLine": {
                "minimum": 1,
                "type": "integer"
              },
              "endLine": {
                "minimum": 1,
                "type": "integer"
              },
              "contentHash": {
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "checkId",
              "exitCode"
            ],
            "properties": {
              "kind": {
                "const": "command",
                "type": "string"
              },
              "checkId": {
                "minLength": 1,
                "maxLength": 128,
                "type": "string"
              },
              "exitCode": {
                "minimum": 0,
                "maximum": 255,
                "type": "integer"
              },
              "artifactId": {
                "minLength": 1,
                "description": "Opaque ArtifactId.",
                "type": "string"
              }
            }
          },
          {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "kind",
              "artifactId",
              "contentHash"
            ],
            "properties": {
              "kind": {
                "const": "artifact",
                "type": "string"
              },
              "artifactId": {
                "minLength": 1,
                "description": "Opaque ArtifactId.",
                "type": "string"
              },
              "contentHash": {
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
