{
  "$id": "heniek://contract/TaskContext/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshot",
    "activeRevision",
    "hierarchy",
    "pendingUpdates"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "snapshot": {
      "$ref": "heniek://contract/TaskSourceSnapshot/v2"
    },
    "activeRevision": {
      "$ref": "heniek://contract/TaskRevision/v1"
    },
    "hierarchy": {
      "$ref": "heniek://contract/TaskHierarchy/v1"
    },
    "pendingUpdates": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "$ref": "heniek://contract/TaskSourceUpdateProposal/v1"
      }
    }
  }
}
