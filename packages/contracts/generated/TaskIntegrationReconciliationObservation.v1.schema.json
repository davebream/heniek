{
  "$id": "heniek://contract/TaskIntegrationReconciliationObservation/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "observationId",
    "reconciliationId",
    "integrationId",
    "runId",
    "taskId",
    "pass",
    "sequence",
    "repositoryId",
    "expectedSha",
    "candidateSha",
    "observedSha",
    "classification",
    "detail",
    "observedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "observationId": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "reconciliationId": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "integrationId": {
      "minLength": 1,
      "maxLength": 512,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "description": "Opaque ExecutionTaskId.",
      "type": "string"
    },
    "pass": {
      "minimum": 1,
      "type": "integer"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "repositoryId": {
      "minLength": 1,
      "description": "Opaque RepositoryId.",
      "type": "string"
    },
    "expectedSha": {
      "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
      "type": "string"
    },
    "candidateSha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedSha": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{40}(?:[0-9a-f]{24})?$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "applied",
          "type": "string"
        },
        {
          "const": "missing_candidate",
          "type": "string"
        },
        {
          "const": "missing_ref",
          "type": "string"
        },
        {
          "const": "observation_failed",
          "type": "string"
        },
        {
          "const": "external_mutation",
          "type": "string"
        },
        {
          "const": "identity_mismatch",
          "type": "string"
        }
      ]
    },
    "detail": {
      "anyOf": [
        {
          "minLength": 1,
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "observedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
