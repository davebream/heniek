{
  "$id": "heniek://contract/DaemonNegotiationRequest/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "auth",
    "transportVersions",
    "requiredMethods"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "auth": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "keyId",
        "sequence",
        "mac"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "keyId": {
          "minLength": 1,
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "maximum": 2147483647,
          "type": "integer"
        },
        "mac": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      }
    },
    "transportVersions": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minimum": 1,
        "type": "integer"
      }
    },
    "requiredMethods": {
      "minItems": 1,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "methodVersions",
          "resultSchemas"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "methodVersions": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "resultSchemas": {
            "minItems": 1,
            "uniqueItems": true,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "schemaId",
                "sha256"
              ],
              "properties": {
                "schemaId": {
                  "minLength": 1,
                  "type": "string"
                },
                "sha256": {
                  "pattern": "^[a-f0-9]{64}$",
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
