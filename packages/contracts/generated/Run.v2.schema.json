{
  "$id": "heniek://contract/Run/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "sourceWorkItemId",
    "codebaseId",
    "repositoryIds",
    "workspaceId",
    "status",
    "instructionSnapshot",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "sourceWorkItemId": {
      "minLength": 1,
      "description": "Opaque SourceWorkItemId.",
      "type": "string"
    },
    "codebaseId": {
      "minLength": 1,
      "description": "Opaque CodebaseId.",
      "type": "string"
    },
    "repositoryIds": {
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque RepositoryId.",
        "type": "string"
      }
    },
    "workspaceId": {
      "minLength": 1,
      "description": "Opaque WorkspaceId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "instructionSnapshot": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "snapshotSha256",
        "capturedAt",
        "readiness",
        "sources",
        "diagnostics"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "snapshotSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "capturedAt": {
          "format": "date-time",
          "type": "string"
        },
        "readiness": {
          "anyOf": [
            {
              "const": "ready",
              "type": "string"
            },
            {
              "const": "blocked",
              "type": "string"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "sourceId",
              "kind",
              "provider",
              "location",
              "scope",
              "precedence",
              "contentSha256"
            ],
            "properties": {
              "sourceId": {
                "minLength": 1,
                "type": "string"
              },
              "kind": {
                "anyOf": [
                  {
                    "const": "shared",
                    "type": "string"
                  },
                  {
                    "const": "provider-native",
                    "type": "string"
                  },
                  {
                    "const": "orchestrator",
                    "type": "string"
                  },
                  {
                    "const": "profile-role",
                    "type": "string"
                  },
                  {
                    "const": "stage",
                    "type": "string"
                  }
                ]
              },
              "provider": {
                "anyOf": [
                  {
                    "const": "claude",
                    "type": "string"
                  },
                  {
                    "const": "codex",
                    "type": "string"
                  },
                  {
                    "const": "cursor",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "location": {
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "kind",
                  "repositoryId",
                  "path"
                ],
                "properties": {
                  "kind": {
                    "anyOf": [
                      {
                        "const": "repository",
                        "type": "string"
                      },
                      {
                        "const": "application-home",
                        "type": "string"
                      }
                    ]
                  },
                  "repositoryId": {
                    "anyOf": [
                      {
                        "minLength": 1,
                        "description": "Opaque RepositoryId.",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "path": {
                    "minLength": 1,
                    "type": "string"
                  }
                }
              },
              "scope": {
                "type": "string"
              },
              "precedence": {
                "minimum": 1,
                "maximum": 5,
                "type": "integer"
              },
              "contentSha256": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              }
            }
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "schemaVersion",
              "code",
              "classification",
              "message",
              "topic",
              "anchors"
            ],
            "properties": {
              "schemaVersion": {
                "const": 1,
                "type": "number"
              },
              "code": {
                "minLength": 1,
                "type": "string"
              },
              "classification": {
                "anyOf": [
                  {
                    "const": "additive",
                    "type": "string"
                  },
                  {
                    "const": "incompatible",
                    "type": "string"
                  },
                  {
                    "const": "indeterminate",
                    "type": "string"
                  }
                ]
              },
              "message": {
                "minLength": 1,
                "type": "string"
              },
              "topic": {
                "minLength": 1,
                "type": "string"
              },
              "anchors": {
                "minItems": 2,
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "sourceId",
                    "startLine",
                    "endLine"
                  ],
                  "properties": {
                    "sourceId": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "startLine": {
                      "minimum": 1,
                      "type": "integer"
                    },
                    "endLine": {
                      "minimum": 1,
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
