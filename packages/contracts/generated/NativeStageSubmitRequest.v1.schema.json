{
  "$id": "heniek://contract/NativeStageSubmitRequest/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "sessionRevision",
    "dispatchId",
    "expectedDispatchRevision",
    "runId",
    "stageId",
    "attemptId",
    "submissionId",
    "outcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "sessionId": {
      "minLength": 1,
      "description": "Opaque ParentSessionId.",
      "type": "string"
    },
    "sessionRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "dispatchId": {
      "minLength": 1,
      "description": "Opaque NativeDispatchId.",
      "type": "string"
    },
    "expectedDispatchRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "attemptId": {
      "minLength": 1,
      "description": "Opaque StageAttemptId.",
      "type": "string"
    },
    "submissionId": {
      "minLength": 1,
      "description": "Opaque NativeSubmissionId.",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "result": {
      "$ref": "heniek://contract/ExternalStageResult/v1"
    },
    "failure": {
      "$ref": "heniek://contract/ExecutionFailure/v1"
    }
  }
}
