          },
          "buildSha": {
            "pattern": "^[0-9a-f]{40}$",
            "type": "string"
          },
          "binarySha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "archiveSha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
