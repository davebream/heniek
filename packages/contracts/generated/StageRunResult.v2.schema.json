{
  "$id": "heniek://contract/StageRunResult/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "stageId",
    "status",
    "artifacts",
    "scheduling",
    "attempts",
    "decisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "sessionId": {
      "minLength": 1,
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "artifactId",
          "mediaType",
          "byteLength",
          "sha256"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "artifactId": {
            "minLength": 1,
            "description": "Opaque ArtifactId.",
            "type": "string"
          },
          "mediaType": {
            "minLength": 1,
            "type": "string"
          },
          "byteLength": {
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        }
      }
    },
    "error": {
      "minLength": 1,
      "type": "string"
    },
    "scheduling": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "revision",
        "state",
        "requestedPriority"
      ],
      "properties": {
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "state": {
          "anyOf": [
            {
              "const": "queued",
              "type": "string"
            },
            {
              "const": "waiting_on_user",
              "type": "string"
            },
            {
              "const": "running",
              "type": "string"
            },
            {
              "const": "terminal",
              "type": "string"
            }
          ]
        },
        "requestedPriority": {
          "minimum": 0,
          "maximum": 9,
          "type": "integer"
        },
        "selectedCandidateIndex": {
          "minimum": 0,
          "type": "integer"
        },
        "selectedProfileId": {
          "minLength": 1,
          "type": "string"
        },
        "selectedAccountId": {
          "minLength": 1,
          "type": "string"
        }
      }
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/ExecutionAttempt/v1"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/SchedulingDecision/v1"
      }
    }
  }
}
