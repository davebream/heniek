{
  "$id": "heniek://contract/TaskWavePlan/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "graphId",
    "graphRevision",
    "waveOrdinal",
    "validation",
    "selectedTaskIds",
    "decisions",
    "plannedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "graphId": {
      "minLength": 1,
      "description": "Opaque TaskGraphId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "waveOrdinal": {
      "minimum": 1,
      "type": "integer"
    },
    "validation": {
      "$ref": "heniek://contract/TaskDagValidationResult/v1"
    },
    "selectedTaskIds": {
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque ExecutionTaskId.",
        "type": "string"
      }
    },
    "decisions": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "taskId",
          "classification",
          "blockingReasons"
        ],
        "properties": {
          "taskId": {
            "minLength": 1,
            "description": "Opaque ExecutionTaskId.",
            "type": "string"
          },
          "classification": {
            "anyOf": [
              {
                "const": "selected",
                "type": "string"
              },
              {
                "const": "deferred",
                "type": "string"
              },
              {
                "const": "settled",
                "type": "string"
              },
              {
                "const": "invalid",
                "type": "string"
              }
            ]
          },
          "blockingReasons": {
            "maxItems": 4096,
            "type": "array",
            "items": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "code",
                "sourceTaskId",
                "repositoryId",
                "profileId",
                "accountId"
              ],
              "properties": {
                "code": {
                  "anyOf": [
                    {
                      "const": "graph_invalid",
                      "type": "string"
                    },
                    {
                      "const": "task_not_pending",
                      "type": "string"
                    },
                    {
                      "const": "graph_revision_pending",
                      "type": "string"
                    },
                    {
                      "const": "predecessor_pending",
                      "type": "string"
                    },
                    {
                      "const": "predecessor_failed",
                      "type": "string"
                    },
                    {
                      "const": "predecessor_cancelled",
                      "type": "string"
                    },
                    {
                      "const": "predecessor_blocked",
                      "type": "string"
                    },
                    {
                      "const": "completion_contract_pending",
                      "type": "string"
                    },
                    {
                      "const": "completion_contract_failed",
                      "type": "string"
                    },
                    {
                      "const": "integration_pending",
                      "type": "string"
                    },
                    {
                      "const": "integration_reconciliation_required",
                      "type": "string"
                    },
                    {
                      "const": "combined_verification_pending",
                      "type": "string"
                    },
                    {
                      "const": "combined_verification_failed",
                      "type": "string"
                    },
                    {
                      "const": "writer_lease_unavailable",
                      "type": "string"
                    },
                    {
                      "const": "profile_unavailable",
                      "type": "string"
                    },
                    {
                      "const": "account_capacity_unknown",
                      "type": "string"
                    },
                    {
                      "const": "account_capacity_exhausted",
                      "type": "string"
                    },
                    {
                      "const": "run_concurrency_exhausted",
                      "type": "string"
                    }
                  ]
                },
                "sourceTaskId": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "description": "Opaque ExecutionTaskId.",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "repositoryId": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "description": "Opaque RepositoryId.",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "profileId": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "description": "Opaque ProfileId.",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "accountId": {
                  "anyOf": [
                    {
                      "minLength": 1,
                      "description": "Opaque AccountId.",
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "plannedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
