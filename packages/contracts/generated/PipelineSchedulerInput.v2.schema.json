{
  "$id": "heniek://contract/PipelineSchedulerInput/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "pipelineId",
    "graphRevision",
    "scheduleRevision",
    "graph",
    "now",
    "stages",
    "observations",
    "canonicalState",
    "pendingEvaluatorEdgeKeys",
    "evaluatorDecisions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "pipelineId": {
      "minLength": 1,
      "description": "Opaque PipelineId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "scheduleRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "graph": {
      "$ref": "heniek://contract/PipelineGraph/v1"
    },
    "now": {
      "format": "date-time",
      "type": "string"
    },
    "deadlineAt": {
      "format": "date-time",
      "type": "string"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/PipelineStageSnapshot/v1"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/PipelineSchedulerObservation/v2"
      }
    },
    "canonicalState": {},
    "pendingEvaluatorEdgeKeys": {
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "evaluatorDecisions": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "edgeKey",
          "selected",
          "recordedAt"
        ],
        "properties": {
          "edgeKey": {
            "minLength": 1,
            "type": "string"
          },
          "selected": {
            "type": "boolean"
          },
          "recordedAt": {
            "format": "date-time",
            "type": "string"
          }
        }
      }
    },
    "recoveryState": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "stageId",
          "generation",
          "repairsUsed",
          "identicalSignatureCount"
        ],
        "properties": {
          "stageId": {
            "minLength": 1,
            "description": "Opaque PipelineStageId.",
            "type": "string"
          },
          "generation": {
            "minimum": 1,
            "type": "integer"
          },
          "repairsUsed": {
            "minimum": 0,
            "type": "integer"
          },
          "lastSignatureDigest": {
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "identicalSignatureCount": {
            "minimum": 0,
            "type": "integer"
          },
          "pendingProposalId": {
            "minLength": 1,
            "type": "string"
          },
          "pendingProposalJson": {}
        }
      }
    },
    "effectiveLimits": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "maxRepairAttempts": {
          "minimum": 0,
          "type": "integer"
        },
        "maxConcurrentWorkers": {
          "minimum": 1,
          "type": "integer"
        },
        "maxPipelineDurationMs": {
          "minimum": 1,
          "type": "integer"
        },
        "maxGraphRevisions": {
          "minimum": 1,
          "type": "integer"
        },
        "stageDurationMsByStageId": {
          "type": "object",
          "patternProperties": {
            "^(.*)$": {
              "minimum": 1,
              "type": "integer"
            }
          }
        }
      }
    },
    "executionMode": {
      "anyOf": [
        {
          "const": "autonomous",
          "type": "string"
        },
        {
          "const": "hitl",
          "type": "string"
        }
      ]
    }
  }
}
