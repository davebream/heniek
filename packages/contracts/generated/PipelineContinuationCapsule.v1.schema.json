{
  "$id": "heniek://contract/PipelineContinuationCapsule/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "capsuleId",
    "runId",
    "stageId",
    "attemptId",
    "segmentId",
    "segmentOrdinal",
    "completedPlanItems",
    "nextAction",
    "repositoryHeads",
    "dirtyFiles",
    "artifactRefs",
    "contextFileRefs",
    "decisionIds",
    "unresolvedQuestionIds",
    "riskRefs",
    "outgoingSessionId",
    "digest",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "capsuleId": {
      "minLength": 1,
      "description": "Opaque PipelineContinuationCapsuleId.",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque PipelineStageId.",
      "type": "string"
    },
    "attemptId": {
      "minLength": 1,
      "description": "Opaque PipelineAttemptId.",
      "type": "string"
    },
    "segmentId": {
      "minLength": 1,
      "description": "Opaque PipelineSegmentId.",
      "type": "string"
    },
    "segmentOrdinal": {
      "minimum": 0,
      "type": "integer"
    },
    "completedPlanItems": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "type": "string"
      }
    },
    "activePlanItem": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "remainingPlanItems": {
      "maxItems": 256,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "type": "string"
      }
    },
    "nextAction": {
      "minLength": 1,
      "maxLength": 1024,
      "type": "string"
    },
    "repositoryHeads": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "repositoryId",
          "head"
        ],
        "properties": {
          "repositoryId": {
            "minLength": 1,
            "description": "Opaque RepositoryId.",
            "type": "string"
          },
          "head": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          }
        }
      }
    },
    "dirtyFiles": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 512,
        "type": "string"
      }
    },
    "artifactRefs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "artifactId",
          "contentHash"
        ],
        "properties": {
          "artifactId": {
            "minLength": 1,
            "description": "Opaque ArtifactId.",
            "type": "string"
          },
          "contentHash": {
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "name": {
            "minLength": 1,
            "maxLength": 128,
            "type": "string"
          }
        }
      }
    },
    "contextFileRefs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "minLength": 1,
            "maxLength": 512,
            "type": "string"
          },
          "contentHash": {
            "minLength": 64,
            "maxLength": 64,
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          }
        }
      }
    },
    "decisionIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "type": "string"
      }
    },
    "unresolvedQuestionIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "type": "string"
      }
    },
    "riskRefs": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "type": "string"
      }
    },
    "telemetryCursor": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "outgoingSessionId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "narrativeDigest": {
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "omittedNarrativeBytes": {
      "minimum": 0,
      "type": "integer"
    },
    "omittedDescriptionCount": {
      "minimum": 0,
      "type": "integer"
    },
    "digest": {
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
