{
  "$id": "heniek://contract/TaskDispatchRecord/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "dispatchId",
    "runId",
    "taskId",
    "graphRevision",
    "waveOrdinal",
    "childRunId",
    "pipelineId",
    "profileId",
    "accountId",
    "workspaceId",
    "repositoryIds",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "dispatchId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "description": "Opaque ExecutionTaskId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "waveOrdinal": {
      "minimum": 1,
      "type": "integer"
    },
    "childRunId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "pipelineId": {
      "minLength": 1,
      "description": "Opaque PipelineId.",
      "type": "string"
    },
    "profileId": {
      "minLength": 1,
      "description": "Opaque ProfileId.",
      "type": "string"
    },
    "accountId": {
      "anyOf": [
        {
          "minLength": 1,
          "description": "Opaque AccountId.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "workspaceId": {
      "minLength": 1,
      "maxLength": 1024,
      "type": "string"
    },
    "repositoryIds": {
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque RepositoryId.",
        "type": "string"
      }
    },
    "recordedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
