{
  "$id": "heniek://contract/TaskLifecycleProjection/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "taskId",
    "graphRevision",
    "phase",
    "childRunId",
    "attemptOrdinal",
    "retryCount",
    "blockReason",
    "completionContract",
    "integration",
    "combinedVerification",
    "revision",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "taskId": {
      "minLength": 1,
      "description": "Opaque ExecutionTaskId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "phase": {
      "anyOf": [
        {
          "const": "not_started",
          "type": "string"
        },
        {
          "const": "dispatching",
          "type": "string"
        },
        {
          "const": "active",
          "type": "string"
        },
        {
          "const": "retrying",
          "type": "string"
        },
        {
          "const": "cancelling",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        }
      ]
    },
    "childRunId": {
      "anyOf": [
        {
          "minLength": 1,
          "description": "Opaque RunId.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attemptOrdinal": {
      "minimum": 0,
      "type": "integer"
    },
    "retryCount": {
      "minimum": 0,
      "type": "integer"
    },
    "blockReason": {
      "anyOf": [
        {
          "$ref": "heniek://contract/TaskPropagationReason/v1"
        },
        {
          "type": "null"
        }
      ]
    },
    "completionContract": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "integration": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "reconciliation_required",
          "type": "string"
        }
      ]
    },
    "combinedVerification": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "passed",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
