{
  "$id": "heniek://contract/TaskWaveAuditEvent/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "runId",
    "taskId",
    "kind",
    "detail",
    "recordedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "eventId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "taskId": {
      "anyOf": [
        {
          "minLength": 1,
          "description": "Opaque ExecutionTaskId.",
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "anyOf": [
        {
          "const": "wave_planned",
          "type": "string"
        },
        {
          "const": "capacity_acquired",
          "type": "string"
        },
        {
          "const": "task_dispatched",
          "type": "string"
        },
        {
          "const": "task_retrying",
          "type": "string"
        },
        {
          "const": "cancellation_requested",
          "type": "string"
        },
        {
          "const": "task_settled",
          "type": "string"
        },
        {
          "const": "task_blocked",
          "type": "string"
        },
        {
          "const": "capacity_released",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        }
      ]
    },
    "detail": {
      "type": "object",
      "patternProperties": {
        "^(.*)$": {}
      }
    },
    "recordedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
