{
  "$id": "heniek://contract/HiddenDependencyFinding/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "findingId",
    "runId",
    "graphId",
    "graphRevision",
    "revisionSha256",
    "reporterTaskId",
    "prerequisiteTaskIds",
    "affectedTaskIds",
    "rationale",
    "evidenceArtifactIds",
    "discoveredAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "findingId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "graphId": {
      "minLength": 1,
      "description": "Opaque TaskGraphId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "revisionSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "reporterTaskId": {
      "minLength": 1,
      "description": "Opaque ExecutionTaskId.",
      "type": "string"
    },
    "prerequisiteTaskIds": {
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque ExecutionTaskId.",
        "type": "string"
      }
    },
    "affectedTaskIds": {
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque ExecutionTaskId.",
        "type": "string"
      }
    },
    "rationale": {
      "minLength": 1,
      "maxLength": 65536,
      "type": "string"
    },
    "evidenceArtifactIds": {
      "minItems": 1,
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque ArtifactId.",
        "type": "string"
      }
    },
    "discoveredAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
