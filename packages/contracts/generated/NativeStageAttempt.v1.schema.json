{
  "$id": "heniek://contract/NativeStageAttempt/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "attemptId",
    "runId",
    "stageId",
    "attemptOrdinal",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "attemptId": {
      "minLength": 1,
      "description": "Opaque StageAttemptId.",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "attemptOrdinal": {
      "minimum": 1,
      "type": "integer"
    },
    "workspaceId": {
      "minLength": 1,
      "description": "Opaque WorkspaceId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "dispatchId": {
      "minLength": 1,
      "description": "Opaque NativeDispatchId.",
      "type": "string"
    },
    "failure": {
      "$ref": "heniek://contract/ExecutionFailure/v1"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "finishedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
