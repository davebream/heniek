{
  "$id": "heniek://contract/StageRunResumeResult/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "status",
    "runRevision",
    "accepted",
    "operationId",
    "deliveryState"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "runRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "accepted": {
      "const": true,
      "type": "boolean"
    },
    "operationId": {
      "minLength": 1,
      "type": "string"
    },
    "deliveryState": {
      "anyOf": [
        {
          "const": "pending",
          "type": "string"
        },
        {
          "const": "delivered",
          "type": "string"
        }
      ]
    }
  }
}
