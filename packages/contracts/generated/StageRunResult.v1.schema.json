{
  "$id": "heniek://contract/StageRunResult/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "stageId",
    "status",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "summary": {
      "minLength": 1,
      "type": "string"
    },
    "sessionId": {
      "minLength": 1,
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "artifactId",
          "mediaType",
          "byteLength",
          "sha256"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "artifactId": {
            "minLength": 1,
            "description": "Opaque ArtifactId.",
            "type": "string"
          },
          "mediaType": {
            "minLength": 1,
            "type": "string"
          },
          "byteLength": {
            "minimum": 0,
            "type": "integer"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        }
      }
    },
    "error": {
      "minLength": 1,
      "type": "string"
    }
  }
}
