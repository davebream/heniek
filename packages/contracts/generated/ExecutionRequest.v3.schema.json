{
  "$id": "heniek://contract/ExecutionRequest/v3",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "stageId",
    "workspaceId",
    "workingDirectory",
    "prompt",
    "artifactPath",
    "inputArtifactRefs",
    "limits",
    "profile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 3,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "workspaceId": {
      "minLength": 1,
      "description": "Opaque WorkspaceId.",
      "type": "string"
    },
    "workingDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "type": "string"
    },
    "artifactPath": {
      "minLength": 1,
      "type": "string"
    },
    "inputArtifactRefs": {
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque ArtifactId.",
        "type": "string"
      }
    },
    "limits": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "maxDurationMs": {
          "minimum": 1,
          "type": "integer"
        },
        "maxTurns": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "profile": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "profileId",
        "workerId",
        "roleId",
        "engine",
        "model",
        "effort",
        "executionMode",
        "questions",
        "instructionsPath",
        "artifactContract",
        "provenance",
        "fingerprint"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "profileId": {
          "minLength": 1,
          "description": "Opaque ProfileId.",
          "type": "string"
        },
        "workerId": {
          "minLength": 1,
          "description": "Opaque WorkerId.",
          "type": "string"
        },
        "roleId": {
          "minLength": 1,
          "description": "Opaque RoleId.",
          "type": "string"
        },
        "engine": {
          "anyOf": [
            {
              "const": "claude",
              "type": "string"
            },
            {
              "const": "codex",
              "type": "string"
            },
            {
              "const": "cursor",
              "type": "string"
            }
          ]
        },
        "accountId": {
          "minLength": 1,
          "description": "Opaque AccountId.",
          "type": "string"
        },
        "billing": {
          "const": "subscription",
          "type": "string"
        },
        "model": {
          "minLength": 1,
          "type": "string"
        },
        "effort": {
          "minLength": 1,
          "type": "string"
        },
        "executionMode": {
          "anyOf": [
            {
              "const": "native",
              "type": "string"
            },
            {
              "const": "external",
              "type": "string"
            }
          ]
        },
        "questions": {
          "anyOf": [
            {
              "const": "parent-mediated",
              "type": "string"
            },
            {
              "const": "direct",
              "type": "string"
            }
          ]
        },
        "instructionsPath": {
          "minLength": 1,
          "pattern": "^(?!/)(?!.*[\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\u0000).+$",
          "type": "string"
        },
        "artifactContract": {
          "minLength": 1,
          "type": "string"
        },
        "focus": {
          "minLength": 1,
          "type": "string"
        },
        "maxDurationMs": {
          "minimum": 1,
          "type": "integer"
        },
        "workspaceStrategy": {
          "minLength": 1,
          "type": "string"
        },
        "provenance": {
          "type": "array",
          "items": {
            "additionalProperties": false,
            "type": "object",
            "required": [
              "field",
              "pointer",
              "layer",
              "value",
              "overridden"
            ],
            "properties": {
              "field": {
                "minLength": 1,
                "type": "string"
              },
              "pointer": {
                "minLength": 1,
                "type": "string"
              },
              "layer": {
                "anyOf": [
                  {
                    "const": "built-in-defaults",
                    "type": "string"
                  },
                  {
                    "const": "global-defaults",
                    "type": "string"
                  },
                  {
                    "const": "codebase",
                    "type": "string"
                  },
                  {
                    "const": "repository",
                    "type": "string"
                  },
                  {
                    "const": "pipeline-template",
                    "type": "string"
                  },
                  {
                    "const": "profile-or-stage",
                    "type": "string"
                  },
                  {
                    "const": "invocation-override",
                    "type": "string"
                  }
                ]
              },
              "sourcePath": {
                "type": "string"
              },
              "value": {},
              "overridden": {
                "type": "array",
                "items": {
                  "additionalProperties": false,
                  "type": "object",
                  "required": [
                    "layer",
                    "value"
                  ],
                  "properties": {
                    "layer": {
                      "anyOf": [
                        {
                          "const": "built-in-defaults",
                          "type": "string"
                        },
                        {
                          "const": "global-defaults",
                          "type": "string"
                        },
                        {
                          "const": "codebase",
                          "type": "string"
                        },
                        {
                          "const": "repository",
                          "type": "string"
                        },
                        {
                          "const": "pipeline-template",
                          "type": "string"
                        },
                        {
                          "const": "profile-or-stage",
                          "type": "string"
                        },
                        {
                          "const": "invocation-override",
                          "type": "string"
                        }
                      ]
                    },
                    "sourcePath": {
                      "type": "string"
                    },
                    "value": {}
                  }
                }
              }
            }
          }
        },
        "fingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      }
    }
  }
}
