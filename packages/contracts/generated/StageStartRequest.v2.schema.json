{
  "$id": "heniek://contract/StageStartRequest/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "currentDirectory",
    "prompt",
    "artifactPath",
    "profileId",
    "priority",
    "requestedIdentifiers",
    "limits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "currentDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "prompt": {
      "minLength": 1,
      "type": "string"
    },
    "artifactPath": {
      "minLength": 1,
      "type": "string"
    },
    "profileId": {
      "minLength": 1,
      "type": "string"
    },
    "priority": {
      "minimum": 0,
      "maximum": 9,
      "type": "integer"
    },
    "requestedIdentifiers": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      }
    },
    "limits": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "maxDurationMs": {
          "minimum": 1,
          "type": "integer"
        },
        "maxTurns": {
          "minimum": 1,
          "type": "integer"
        }
      }
    }
  }
}
