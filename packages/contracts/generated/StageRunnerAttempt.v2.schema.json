{
  "$id": "heniek://contract/StageRunnerAttempt/v2",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "attemptId",
    "runId",
    "stageId",
    "stageType",
    "intentId",
    "graphRevision",
    "generation",
    "attemptOrdinal",
    "phase",
    "outputs",
    "evidence",
    "recovery",
    "revision",
    "updatedAt",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2,
      "type": "number"
    },
    "attemptId": {
      "minLength": 1,
      "description": "Opaque PipelineAttemptId.",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque PipelineStageId.",
      "type": "string"
    },
    "stageType": {
      "anyOf": [
        {
          "const": "agent",
          "type": "string"
        },
        {
          "const": "command",
          "type": "string"
        },
        {
          "const": "approval",
          "type": "string"
        },
        {
          "const": "integration",
          "type": "string"
        },
        {
          "const": "verify",
          "type": "string"
        },
        {
          "const": "publish",
          "type": "string"
        }
      ]
    },
    "intentId": {
      "minLength": 1,
      "description": "Opaque PipelineSchedulerIntentId.",
      "type": "string"
    },
    "graphRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "generation": {
      "minimum": 1,
      "type": "integer"
    },
    "attemptOrdinal": {
      "minimum": 1,
      "type": "integer"
    },
    "phase": {
      "anyOf": [
        {
          "const": "prepare",
          "type": "string"
        },
        {
          "const": "start",
          "type": "string"
        },
        {
          "const": "observe",
          "type": "string"
        },
        {
          "const": "cancel",
          "type": "string"
        },
        {
          "const": "collect",
          "type": "string"
        },
        {
          "const": "validate",
          "type": "string"
        },
        {
          "const": "finalize",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        }
      ]
    },
    "workspaceId": {
      "minLength": 1,
      "description": "Opaque WorkspaceId.",
      "type": "string"
    },
    "leaseId": {
      "minLength": 1,
      "type": "string"
    },
    "checkoutPath": {
      "minLength": 1,
      "type": "string"
    },
    "processGroupId": {
      "minimum": 1,
      "type": "integer"
    },
    "backendExecutionId": {
      "minLength": 1,
      "type": "string"
    },
    "operationId": {
      "minLength": 1,
      "type": "string"
    },
    "deadlineAt": {
      "format": "date-time",
      "type": "string"
    },
    "runtimeDirectory": {
      "minLength": 1,
      "type": "string"
    },
    "preparedAt": {
      "format": "date-time",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "finishedAt": {
      "format": "date-time",
      "type": "string"
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/StageRunnerOutputBinding/v1"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/StageRunnerEvidence/v1"
      }
    },
    "result": {
      "$ref": "heniek://contract/StageRunnerResult/v2"
    },
    "failure": {
      "$ref": "heniek://contract/StageRunnerFailure/v2"
    },
    "recovery": {
      "anyOf": [
        {
          "const": "none",
          "type": "string"
        },
        {
          "const": "observe_backend",
          "type": "string"
        },
        {
          "const": "reap_process",
          "type": "string"
        },
        {
          "const": "reconcile_artifacts",
          "type": "string"
        },
        {
          "const": "reconcile_git",
          "type": "string"
        },
        {
          "const": "reconcile_forge",
          "type": "string"
        },
        {
          "const": "await_approval",
          "type": "string"
        },
        {
          "const": "manual",
          "type": "string"
        }
      ]
    },
    "revision": {
      "minimum": 1,
      "type": "integer"
    },
    "updatedAt": {
      "format": "date-time",
      "type": "string"
    },
    "createdAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
