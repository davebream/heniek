{
  "$id": "heniek://contract/RuntimeCompatibilityReport/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "reportId",
    "runtime",
    "suiteVersion",
    "status",
    "checks",
    "completedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "reportId": {
      "minLength": 1,
      "type": "string"
    },
    "runtime": {
      "additionalProperties": false,
      "type": "object",
      "required": [
        "schemaVersion",
        "engine",
        "sourceMode",
        "entryPath",
        "version",
        "buildSha",
        "binarySha256"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1,
          "type": "number"
        },
        "engine": {
          "minLength": 1,
          "type": "string"
        },
        "sourceMode": {
          "anyOf": [
            {
              "const": "managed",
              "type": "string"
            },
            {
              "const": "external",
              "type": "string"
            }
          ]
        },
        "entryPath": {
          "minLength": 1,
          "type": "string"
        },
        "version": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "buildSha": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "binarySha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "archiveSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      }
    },
    "suiteVersion": {
      "minimum": 1,
      "type": "integer"
    },
    "status": {
      "anyOf": [
        {
          "const": "pass",
          "type": "string"
        },
        {
          "const": "fail",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name",
          "status",
          "message"
        ],
        "properties": {
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "status": {
            "anyOf": [
              {
                "const": "pass",
                "type": "string"
              },
              {
                "const": "fail",
                "type": "string"
              },
              {
                "const": "blocked",
                "type": "string"
              }
            ]
          },
          "message": {
            "minLength": 1,
            "type": "string"
          }
        }
      }
    },
    "completedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
