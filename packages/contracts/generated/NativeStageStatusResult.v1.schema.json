{
  "$id": "heniek://contract/NativeStageStatusResult/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "stageId",
    "status",
    "runRevision",
    "stageState",
    "stageRevision",
    "attemptCount",
    "attempts",
    "interactions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "runRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "stageState": {
      "anyOf": [
        {
          "const": "waiting_for_parent",
          "type": "string"
        },
        {
          "const": "dispatched",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "settled",
          "type": "string"
        }
      ]
    },
    "stageRevision": {
      "minimum": 1,
      "type": "integer"
    },
    "attemptCount": {
      "minimum": 0,
      "type": "integer"
    },
    "currentAttemptId": {
      "minLength": 1,
      "description": "Opaque StageAttemptId.",
      "type": "string"
    },
    "waitingSince": {
      "format": "date-time",
      "type": "string"
    },
    "attempts": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/NativeStageAttempt/v1"
      }
    },
    "interactions": {
      "type": "array",
      "items": {
        "$ref": "heniek://contract/Interaction/v2"
      }
    },
    "result": {
      "$ref": "heniek://contract/ExternalStageResult/v1"
    }
  }
}
