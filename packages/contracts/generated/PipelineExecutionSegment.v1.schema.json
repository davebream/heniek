{
  "$id": "heniek://contract/PipelineExecutionSegment/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "segmentId",
    "runId",
    "profileId",
    "stageIds",
    "status",
    "softThreshold",
    "hardThreshold",
    "startedAt"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "segmentId": {
      "minLength": 1,
      "description": "Opaque PipelineSegmentId.",
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "profileId": {
      "minLength": 1,
      "description": "Opaque ProfileId.",
      "type": "string"
    },
    "profileFingerprint": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "workspaceId": {
      "minLength": 1,
      "description": "Opaque WorkspaceId.",
      "type": "string"
    },
    "leaseId": {
      "minLength": 1,
      "maxLength": 128,
      "type": "string"
    },
    "backendExecutionId": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "stageIds": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "minLength": 1,
        "description": "Opaque PipelineStageId.",
        "type": "string"
      }
    },
    "status": {
      "anyOf": [
        {
          "const": "open",
          "type": "string"
        },
        {
          "const": "checkpointed",
          "type": "string"
        },
        {
          "const": "closed",
          "type": "string"
        },
        {
          "const": "blocked",
          "type": "string"
        }
      ]
    },
    "softThreshold": {
      "minimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "hardThreshold": {
      "minimum": 0,
      "maximum": 1,
      "type": "number"
    },
    "telemetryCursor": {
      "minLength": 1,
      "maxLength": 256,
      "type": "string"
    },
    "capsuleId": {
      "minLength": 1,
      "description": "Opaque PipelineContinuationCapsuleId.",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "closedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
