{
  "$id": "heniek://contract/ExecutionAttempt/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "attemptId",
    "runId",
    "stageId",
    "candidateIndex",
    "profileId",
    "status",
    "limits",
    "permissions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "attemptId": {
      "minLength": 1,
      "type": "string"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "stageId": {
      "minLength": 1,
      "description": "Opaque StageId.",
      "type": "string"
    },
    "candidateIndex": {
      "minimum": 0,
      "type": "integer"
    },
    "profileId": {
      "minLength": 1,
      "description": "Opaque ProfileId.",
      "type": "string"
    },
    "accountId": {
      "minLength": 1,
      "type": "string"
    },
    "workspaceId": {
      "minLength": 1,
      "description": "Opaque WorkspaceId.",
      "type": "string"
    },
    "status": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "backendExecutionId": {
      "minLength": 1,
      "description": "Opaque BackendExecutionId.",
      "type": "string"
    },
    "limits": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "maxDurationMs": {
          "minimum": 1,
          "type": "integer"
        },
        "maxTurns": {
          "minimum": 1,
          "type": "integer"
        }
      }
    },
    "permissions": {
      "$ref": "heniek://contract/ExecutionPermissionEnvelope/v1"
    },
    "failure": {
      "$ref": "heniek://contract/ExecutionFailure/v1"
    },
    "startedAt": {
      "format": "date-time",
      "type": "string"
    },
    "finishedAt": {
      "format": "date-time",
      "type": "string"
    }
  }
}
