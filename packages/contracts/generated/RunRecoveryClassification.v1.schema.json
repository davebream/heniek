{
  "$id": "heniek://contract/RunRecoveryClassification/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "classification",
    "runStatus",
    "probeOutcome"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "runId": {
      "minLength": 1,
      "description": "Opaque RunId.",
      "type": "string"
    },
    "classification": {
      "anyOf": [
        {
          "const": "resumable",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "const": "unknown",
          "type": "string"
        }
      ]
    },
    "runStatus": {
      "anyOf": [
        {
          "const": "queued",
          "type": "string"
        },
        {
          "const": "running",
          "type": "string"
        },
        {
          "const": "waiting_on_user",
          "type": "string"
        },
        {
          "const": "waiting_for_parent_session",
          "type": "string"
        },
        {
          "const": "recovery_required",
          "type": "string"
        },
        {
          "const": "succeeded",
          "type": "string"
        },
        {
          "const": "failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        }
      ]
    },
    "probeOutcome": {
      "anyOf": [
        {
          "const": "status",
          "type": "string"
        },
        {
          "const": "error",
          "type": "string"
        }
      ]
    }
  }
}
