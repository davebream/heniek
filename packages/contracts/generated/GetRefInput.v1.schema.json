{
  "$id": "heniek://contract/GetRefInput/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "repositoryId",
    "qualifiedRef"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "repositoryId": {
      "minLength": 1,
      "description": "Opaque RepositoryId.",
      "type": "string"
    },
    "qualifiedRef": {
      "minLength": 6,
      "pattern": "^refs/[^/]+/.+",
      "type": "string"
    }
  }
}
