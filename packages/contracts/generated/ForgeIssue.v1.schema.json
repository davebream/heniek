{
  "$id": "heniek://contract/ForgeIssue/v1",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "schemaVersion",
    "issueId",
    "repositoryId",
    "number",
    "url",
    "title",
    "body",
    "state",
    "labels",
    "observedVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "type": "number"
    },
    "issueId": {
      "minLength": 1,
      "description": "Opaque ForgeIssueId.",
      "type": "string"
    },
    "repositoryId": {
      "minLength": 1,
      "description": "Opaque RepositoryId.",
      "type": "string"
    },
    "number": {
      "minimum": 1,
      "type": "integer"
    },
    "url": {
      "format": "uri",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "state": {
      "anyOf": [
        {
          "const": "open",
          "type": "string"
        },
        {
          "const": "closed",
          "type": "string"
        }
      ]
    },
    "labels": {
      "uniqueItems": true,
      "type": "array",
      "items": {
        "minLength": 1,
        "type": "string"
      }
    },
    "linkageDigest": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "observedVersion": {
      "minLength": 1,
      "description": "Opaque ForgeObservedVersion.",
      "type": "string"
    }
  }
}
