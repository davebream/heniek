{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["npm", "github-actions"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 0-5 1 * *"],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 2,
  "labels": ["dependencies"],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "vulnerabilityAlerts": {
    "enabled": false,
  },
  "osvVulnerabilityAlerts": false,
  "packageRules": [
    {
      "description": ["Group and auto-merge npm minor and patch updates"],
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies",
      "addLabels": ["javascript"],
      "automerge": true,
    },
    {
      "description": ["Group and auto-merge GitHub Actions minor and patch updates"],
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions non-major dependencies",
      "addLabels": ["github_actions"],
      "automerge": true,
    },
    {
      "description": ["Require approval for potentially breaking pre-1.0 minor updates"],
      "matchManagers": ["npm"],
      "matchCurrentVersion": "/^0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": "unstable dependency minors",
      "dependencyDashboardApproval": true,
      "automerge": false,
    },
    {
      "description": ["Require approval for all major updates"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false,
    },
  ],
}
